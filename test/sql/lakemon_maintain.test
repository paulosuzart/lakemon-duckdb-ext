# name: test/sql/lakemon_maintain.test
# description: bind/error smoke for table maintain, global maintain, and table stats
# group: [sql]

require lakemon

# Missing DuckLake catalog: maintain emits an error row and keeps the session.
query II
SELECT step, status FROM lakemon_maintain('no_such_lake');
----
inventory	error

query I
SELECT count(*) FROM lakemon_maintain('no_such_lake') WHERE details LIKE '%lakemon:%';
----
1

# Table named knobs bind; failure is still an inventory error row, not a bind crash.
query II
SELECT step, status FROM lakemon_maintain('no_such_lake', dry_run => true, max_compacted_files => 4);
----
inventory	error

query II
SELECT step, status FROM lakemon_maintain('no_such_lake', 'main.events', max_compacted_files => 4);
----
inventory	error

# Retention named params moved to lakemon_maintain_global (bind error, not execute).
statement error
CALL lakemon_maintain('no_such_lake', skip_expire => true);
----
skip_expire

statement error
CALL lakemon_maintain('no_such_lake', skip_cleanup => true);
----
skip_cleanup

statement error
CALL lakemon_maintain('no_such_lake', expire_older_than => '7 days');
----
expire_older_than

statement error
CALL lakemon_maintain('no_such_lake', delete_older_than => '3 days');
----
delete_older_than

# Catalog-global CALL is registered. Skip both retention steps without executing DuckLake.
query II
SELECT step, status FROM lakemon_maintain_global('no_such_lake', skip_expire => true, skip_cleanup => true)
WHERE step IN ('expire_snapshots', 'cleanup_old_files')
ORDER BY step;
----
cleanup_old_files	skip
expire_snapshots	skip

# dry_run plans expire/cleanup SQL without requiring an attached catalog.
query II
SELECT step, status FROM lakemon_maintain_global('no_such_lake', dry_run => true, expire_older_than => '7 days', skip_cleanup => true)
WHERE step = 'expire_snapshots';
----
expire_snapshots	planned

query I
SELECT count(*) FROM lakemon_maintain_global('no_such_lake', dry_run => true, expire_older_than => '7 days', skip_cleanup => true)
WHERE step = 'expire_snapshots' AND details LIKE '%ducklake_expire_snapshots%';
----
1

query II
SELECT step, status FROM lakemon_maintain_global('no_such_lake', dry_run => true, skip_expire => true, delete_older_than => '3 days')
WHERE step IN ('cleanup_old_files', 'delete_orphaned_files')
ORDER BY step;
----
cleanup_old_files	planned
delete_orphaned_files	planned

query I
SELECT count(*) FROM lakemon_maintain_global('no_such_lake', dry_run => true, skip_expire => true)
WHERE step = 'cleanup_old_files' AND details LIKE '%ducklake_cleanup_old_files%' AND details LIKE '%cleanup_all%';
----
1

query I
SELECT count(*) FROM lakemon_maintain_global('no_such_lake', dry_run => true, skip_expire => true)
WHERE step = 'delete_orphaned_files' AND details LIKE '%ducklake_delete_orphaned_files%';
----
1

# dry_run still plans expire SQL (no attached catalog, no DuckLake execute).
query II
SELECT step, status FROM lakemon_maintain_global('no_such_lake', dry_run => true, expire_older_than => '7 days', skip_cleanup => true)
WHERE step = 'expire_snapshots';
----
expire_snapshots	planned

query I
SELECT count(*) FROM lakemon_maintain_global('no_such_lake', dry_run => true, expire_older_than => '7 days', skip_cleanup => true)
WHERE step = 'expire_snapshots' AND details LIKE '%now()::TIMESTAMP - INTERVAL%';
----
1

# Execute without an attached catalog: expire CALL fails; skip_cleanup is skip.
query II
SELECT step, status FROM lakemon_maintain_global('no_such_lake', expire_older_than => '7 days', skip_cleanup => true)
WHERE step IN ('expire_snapshots', 'cleanup_old_files')
ORDER BY step;
----
cleanup_old_files	skip
expire_snapshots	error

# PRAGMA rewrite uses the same ExecutePlannedRows path as CALL/SELECT.
# Missing ducklake is an error row (not INTERNAL). Assert the row and message.
query II
SELECT step, status FROM lakemon_maintain('no_such_lake');
----
inventory	error

query I
SELECT count(*) FROM lakemon_maintain_global('no_such_lake', expire_older_than => '7 days', skip_cleanup => true)
WHERE step = 'expire_snapshots' AND status = 'error' AND details LIKE '%ducklake is not loaded%';
----
1

statement ok
PRAGMA lakemon_maintain('no_such_lake');

statement ok
PRAGMA lakemon_maintain_global('no_such_lake', expire_older_than='7 days', skip_cleanup=true);

# EXPLAIN / PREPARE / BEGIN refuse dry_run => false even with no catalog.
statement error
EXPLAIN SELECT * FROM lakemon_maintain('no_such_lake', dry_run => false);
----
EXPLAIN

statement error
PREPARE lakemon_missing AS SELECT * FROM lakemon_maintain_global('no_such_lake', dry_run => false);
----
PREPARE

statement error
CREATE VIEW lakemon_missing_view AS SELECT * FROM lakemon_maintain('no_such_lake', dry_run => false);
----
CREATE

# Bare ? is refused before execute. Sqllogictest supplies no parameter values,
# so DuckDB errors at bind ("parameter"); C API / driver prepare is covered
# by the Postgres lake script.
statement error
SELECT * FROM lakemon_maintain(?, dry_run => false);
----
parameter

statement ok
BEGIN;

statement error
CALL lakemon_maintain('no_such_lake', dry_run => false);
----
explicit transaction

statement ok
ROLLBACK;


# Table-only knobs do not bind on the global CALL.
statement error
CALL lakemon_maintain_global('no_such_lake', max_compacted_files => 4);
----
max_compacted_files

# Global CALL is catalog-only (no table argument).
statement error
CALL lakemon_maintain_global('no_such_lake', 'main.events');
----
lakemon_maintain_global

statement ok
SET lakemon_log_stderr = true;

statement ok
RESET lakemon_log_stderr;

statement ok
SET lakemon_flush_inlined_max_delete_files = 0;

statement ok
RESET lakemon_flush_inlined_max_delete_files;

# Session remains usable after the inventory / global error rows.
query I
SELECT lakemon_version();
----
0.1.1

# table_stats uses the DuckDB error path (no status column).
statement error
CALL lakemon_table_stats('no_such_lake');
----
lakemon:

# Empty catalog is a bind error, not process death.
# Live option honor (rewrite_delete_threshold / target_file_size / expire_older_than /
# delete_older_than / auto_compact) needs an attached DuckLake; see README Tests.
# Planner: delete_threshold <= 0 never emits a rewrite CALL (policy-test).
statement error
CALL lakemon_maintain('');
----
lakemon:

statement error
CALL lakemon_maintain_global('');
----
lakemon:

statement error
CALL lakemon_table_stats('');
----
lakemon:
